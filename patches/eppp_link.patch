diff --git a/managed_components/espressif__eppp_link/eppp_link.c b/managed_components/espressif__eppp_link/eppp_link.c
index a3dfde3..eb36ff1 100644
--- a/managed_components/espressif__eppp_link/eppp_link.c
+++ b/managed_components/espressif__eppp_link/eppp_link.c
@@ -369,4 +369,19 @@
