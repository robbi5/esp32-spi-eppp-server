diff --git a/managed_components/espressif__eppp_link/eppp_link.c b/managed_components/espressif__eppp_link/eppp_link.c
index 198a783..8a18470 100644
--- a/managed_components/espressif__eppp_link/eppp_link.c
+++ b/managed_components/espressif__eppp_link/eppp_link.c
@@ -369,3 +369,18 @@ void* eppp_get_context(esp_netif_t *netif)
     return h->context;
 }
 #endif
+
+esp_err_t eppp_get_stats(esp_netif_t *netif, uint32_t *tx_packets, uint32_t *rx_packets, uint32_t *err_packets)
+{
+    if (netif == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    struct eppp_handle *h = esp_netif_get_io_driver(netif);
+    if (h == NULL) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (tx_packets) *tx_packets = h->tx_packets;
+    if (rx_packets) *rx_packets = h->rx_packets;
+    if (err_packets) *err_packets = h->err_packets;
+    return ESP_OK;
+}
